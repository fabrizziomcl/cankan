# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
pipenv/
Pipfile.lock

# VSCode / IDE
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln
*.pyproj

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Jupyter
.ipynb_checkpoints/
# (Keep notebooks themselves tracked; ignore checkpoint copies)

# Python caches & tooling
.mypy_cache/
.pytest_cache/
.tox/
.coverage
coverage.xml
htmlcov/

# Build / distribution
build/
dist/
*.egg-info/
*.egg
*.whl

# Logs
*.log
logs/
debug.log

# Sensitive / env
.env
*.pem
*.key
secrets.yml

# Large model / training artifacts (ignore binary checkpoints & caches)
# - src/model contains saved checkpoints and caches: ignore states and cache_data
/src/model/*_state
/src/model/*_cache_data
/src/model/*.pt
/src/model/*.pth
/src/model/*.ckpt
/src/model/*.zip
/src/model/history.txt

# Other model/data artifacts
/efficient_kan/data/
/efficient_kan/data/**/raw/
/**/cache_data/
**/*.npz
**/*.bin

# PyTorch / ML artifacts
*.tensorboard
runs/
checkpoints/
*.ckpt

# Figures / generated outputs (optional: untrack large auto-generated images)
figures_kan_functions/
src/figures/

# Notebook / temporary files
*.ipynb_checkpoints
*.tmp
*.bak
*.swp

# Misc
*.sqlite
*.db

# Keep project config files (yaml, small configs) tracked unless you want them ignored explicitly.
